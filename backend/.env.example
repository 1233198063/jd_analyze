DATABASE_URL=postgresql+asyncpg://jdanalyze:jdanalyze_dev@localhost:5432/jdanalyze
REDIS_URL=redis://localhost:6379/0

# AI runs through the local Codex CLI — sign in once with `codex login` (or the Codex app).
# CODEX_PATH is auto-detected when left empty.
CODEX_PATH=
CODEX_MODEL=gpt-6-sol
CODEX_REASONING_EFFORT=low
CODEX_TIMEOUT_SECONDS=240

SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# DOL / USCIS data directory (where you put downloaded CSV files)
H1B_DATA_DIR=./data/h1b
